# Local Docker build. Copy to .env.docker.local before building.
# The API is accessed directly because local development has no native Nginx
# reverse proxy in front of Vite/static files.
VITE_API_BASE_URL=http://localhost:8008/api/v1
VITE_API_URL=http://localhost:8008/api/v1
VITE_APP_VERSION=local

# The Compose build job copies the compiled bundle here.
FRONTEND_DIST_HOST_PATH=./dist
