# Copy to byfrontend/.env.production.local for local production-like Docker
# builds or as the template for the VPS deployment file. Never commit the
# real file — it is covered by .gitignore.

# Same-origin path behind the native VPS Nginx (see docker/nginx/by-frontend.vps.conf).
VITE_API_BASE_URL=/api/v1
VITE_API_URL=/api/v1
VITE_APP_VERSION=local

# Host path where the compiled dist/ is extracted for Nginx to serve.
# On the VPS this should be /var/www/by-frontend/dist.
FRONTEND_DIST_HOST_PATH=./dist
